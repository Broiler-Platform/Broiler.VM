<Project>

  <!--
    Central package versions for Broiler.VM.

    Two parts of this repository deliberately carry their own Directory.Packages.props instead,
    for the same reason they carry their own Directory.Build.props: samples/ (pristine package
    consumers) and src/Broiler.VM.HyperV/ (a component that shares nothing with this one).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.5.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />

    <!-- Broiler.VM.Architecture.Tests only; see that project for why each is pinned. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

</Project>

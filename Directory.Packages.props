<Project>
  <!--
    Central package versions for Broiler.VM.

    Two parts of this repository deliberately carry their own Directory.Packages.props instead,
    for the same reason they carry their own Directory.Build.props: samples/ (pristine package
    consumers) and src/Broiler.VM.HyperV/ (a component that shares nothing with this one).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- The shared JavaScript libraries (ADR 0014), restored from nuget.org (decision SJL-D-4 (c)): the
         committed feed eng/packages/ holds no package since the owner's change of 2026-10-30 and
         2026-10-31. Rule I1 holds every reference to the allow-list,
         src/tests/Broiler.VM.Architecture.Tests/admitted-packages.json: the version and content hash
         restore records, and the restored archive's hash. (Revised 2026-11-01. It read: "from the
         committed feed eng/packages/ while an area is in development (decision SJL-D-4 (c)). Rule I1
         holds every reference to the allow-list, src/tests/Broiler.VM.Architecture.Tests/admitted-packages.json,
         and to its pin.") -->
    <!-- The shared stream moved to the published 0.1.0-preview.11 on 2026-11-13, with every package of it this
         family references (Broiler.JS e4b6b49e, tag ecmascript-v0.1.0-preview.11). The line read
         <PackageVersion Include="Broiler.ECMAScript.Algorithms" Version="0.1.0-preview.10" />. -->
    <PackageVersion Include="Broiler.ECMAScript.Algorithms" Version="0.1.0-preview.11" />
    <!-- The shared syntax library (JSD-0083, decision D29; milestone SJL-13.3, step 1), from the same source
         and under the same rule, referenced by the JavaScript compiler alone; it carries no data (added
         2026-11-08, admitted at 0.1.0-preview.10 with the stream the other packages above and below move to;
         2026-11-13, when the stream moved to 0.1.0-preview.11: the line read
         <PackageVersion Include="Broiler.ECMAScript.Frontend" Version="0.1.0-preview.10" />). -->
    <PackageVersion Include="Broiler.ECMAScript.Frontend" Version="0.1.0-preview.11" />
    <!-- The shared Intl library (JSD-0082, decision D9; milestone SJL-9.4), from the same source and under the
         same rule, referenced by the JavaScript profile alone; it carries no locale data, which this family
         embeds in its optional Intl data assembly (decision SJL-D-6 (c)). (2026-11-13, when the stream moved to
         0.1.0-preview.11, which carries the library's changes of 2026-11-08 and 2026-11-09: the line read
         <PackageVersion Include="Broiler.ECMAScript.Intl" Version="0.1.0-preview.10" />.) -->
    <PackageVersion Include="Broiler.ECMAScript.Intl" Version="0.1.0-preview.11" />
    <!-- The time data home's generator (JSD-0076; milestone SJL-8.5), from the same source and under
         the same rule (2026-11-01: it read "from the same committed feed"), admitted test-only, for the architecture tests alone; no package carries the time
         zone or calendar tables (decision SJL-D-6 (c)). Since SJL-9.2c (JSD-0082) the architecture tests also run
         the Intl data home's generator, which it carries since 0.1.0-preview.8 (2026-11-03, when it moved to the published
         0.1.0-preview.9: it read "which 0.1.0-preview.8 carries"); no package carries the Intl tables either.
         (2026-11-13, when the stream moved to 0.1.0-preview.11: the line read
         <PackageVersion Include="Broiler.ECMAScript.Generation" Version="0.1.0-preview.10" />.) -->
    <PackageVersion Include="Broiler.ECMAScript.Generation" Version="0.1.0-preview.11" />
    <!-- The Unicode area's owner packages (JSD-0074; milestone SJL-7.4), from the same source and under
         the same rule (2026-11-01: it read "from the same committed feed"). Broiler.Unicode.Generation is admitted test-only, for the architecture
         tests alone; Broiler.Unicode.Tables is not admitted (decision SJL-D-6 (c)). -->
    <PackageVersion Include="Broiler.Unicode.Algorithms" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Unicode.Segmentation" Version="0.1.0-preview.6" />
    <PackageVersion Include="Broiler.Unicode.Generation" Version="0.1.0-preview.6" />
    <!-- Broiler.VM.Architecture.Tests only; see that project for why each is pinned. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
  </ItemGroup>
</Project>

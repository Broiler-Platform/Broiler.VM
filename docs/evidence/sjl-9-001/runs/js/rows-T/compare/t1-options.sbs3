= fractionalSecondDigits: "2.9" => "12"
= hour12: "false" (a string is true) => "h12"
= calendar: "gregory-x" (malformed) => THROWS RangeError
= calendar: "abc" (well formed, unknown) => "gregory"
= numberingSystem: "latn!" => THROWS RangeError
= formatMatcher: "basic" => "January 5"

= {minute, second} timeZone UTC => [minute:"00", literal:":", second:"05"]
= {minute, second} no timeZone (the default zone) => [minute:"00", literal:":", second:"05"]
= {minute, second} timeZone Asia/Kathmandu => [minute:"45", literal:":", second:"05"]
= format {minute, second} timeZone UTC => "00:05"
= default zone resolved => "UTC"
= timeZone "America/Lo\u017f_Angeles" => THROWS RangeError
= timeZone "Asia/\u212aolkata" => THROWS RangeError
= timeZone "Asia/Kolkat\u0131" => THROWS RangeError
= timeZone "AMERICA/LOS_ANGELES" => "America/Los_Angeles"
= timeZone "america/los_angeles" => "America/Los_Angeles"
-- 10 same, 0 differ; Node equals VM 0, JS 0, neither 0

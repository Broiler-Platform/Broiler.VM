= 8.64e15 {minute, second} => [minute:"00", literal:":", second:"00"]
= 8.64e15 + 1 => THROWS RangeError: Invalid time value
= NaN => THROWS RangeError: Invalid time value
= a string "0" => [month:"1", literal:"/", day:"1", literal:"/", year:"1970"]
= a Date object => [month:"1", literal:"/", day:"5", literal:"/", year:"2024"]
= 1.9 (TimeClip truncates) => [second:"0", literal:".", fractionalSecond:"001"]
= -0.5 => [second:"0", literal:".", fractionalSecond:"000"]
= a BigInt => THROWS TypeError
= a Symbol => THROWS TypeError
= {minute, second} in Asia/Kolkata at 12:00:05Z (sjl-6-001 leftover) => [minute:"30", literal:":", second:"05"]
= {minute, second} in Asia/Kathmandu => ["45:05"]
= {minute} in Asia/Kolkata => "30"
# {hour, minute} in Asia/Kolkata at the epoch
   VM: "5:30\u202fAM"
   JS: "5:30 AM"
   Node (JS): "5:30 AM"
= Date#toLocaleTimeString({minute, second}) in Asia/Kolkata => "30:05"
= format of an Object with valueOf => "1/5/2024"
= formatToParts property order and prototype => ["type,value", true]

<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for the samples. ONE source, and it is a directory of .nupkg files that
    `dotnet pack` produced.

    <clear /> drops every source the machine has configured, nuget.org included, and nothing is
    added back. That is not tidiness; it is the assertion. If these packages carried a runtime
    dependency on anything at all, restore here would fail outright rather than quietly resolving
    it from the internet - so a green restore is evidence that the three packages depend on
    nothing, and evidence that this sample reaches Broiler.VM only through them.

    The feed is created by the evidence collection script and is not in the repository: it holds
    build output, and checking build output in would make the sample restore against a stale copy
    of the packages it is supposed to be testing.
  -->
  <packageSources>
    <clear />
    <add key="local-feed" value="../artifacts/feed" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local-feed">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

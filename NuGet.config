<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.VM.

    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves the same way on every developer box and in CI, and so a standalone checkout of
    this submodule restores identically to one nested inside Broiler.Browser.

    Only nuget.org is listed. Broiler.VM's project graph is closed over its own projects and
    reaches no other Broiler component - ADR 0001 makes that an architecture-tested rule - so
    nothing here resolves a Broiler.* package, and the Broiler-Platform GitHub Packages feed is
    deliberately absent: that feed requires authentication even for public packages and would
    answer 401 for every lookup.

    Never commit a token here.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

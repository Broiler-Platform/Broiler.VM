<?xml version="1.0" encoding="utf-8"?>
<!--
  Two sources, and package source mapping that decides which may supply what (decision SJL-D-4 (c),
  milestone SJL-2.7):
    - broiler-shared, the committed and hash-pinned feed eng/packages/, may supply the shared JavaScript
      libraries' packages (Broiler.ECMAScript.*) while an area is in development;
    - nuget.org may supply those too, for anything a Broiler.VM package release depends on, and is the
      only source of every other package.
  A lock file pins the content hash whichever source supplies a package, and rule I1 reads it. No other
  repository's local folder is ever a source here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-shared" value="eng/packages" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Broiler.ECMAScript.*" />
    </packageSource>
    <packageSource key="broiler-shared">
      <package pattern="Broiler.ECMAScript.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Two sources, and package source mapping that decides which may supply what (decision SJL-D-4 (c),
  milestone SJL-2.7):
    - nuget.org supplies every package, the shared JavaScript libraries' (Broiler.ECMAScript.*) and the
      Unicode area's owner packages (Broiler.Unicode.*, added at SJL-7.4) among them: since the owner's
      change of 2026-10-30 and 2026-10-31 every admitted package restores from it;
    - broiler-shared, the folder eng/packages/, may supply those two prefixes too, and holds no package
      since that change; a package not yet published may be placed there for development, with a pin
      beside it.
  Rule I1 holds every admitted package, whichever source supplied it, to its entry in the allow-list
  src/tests/Broiler.VM.Architecture.Tests/admitted-packages.json: each referencing project's
  obj/project.assets.json to the entry's version and content hash, and the copy restore placed in the
  NuGet global packages folder to the entry's archive hash. No other repository's local folder is ever a
  source here.
  (Revised 2026-11-01, completing the owner's change of 2026-10-30 and 2026-10-31, which emptied
  eng/packages/ and removed the lock files. The first bullet read "broiler-shared, the committed and
  hash-pinned feed eng/packages/, may supply the shared JavaScript libraries' packages
  (Broiler.ECMAScript.*) and the Unicode area's owner packages (Broiler.Unicode.*, added at SJL-7.4)
  while an area is in development;", the second "nuget.org may supply those too, for anything a
  Broiler.VM package release depends on, and is the only source of every other package.", and the last
  sentence began "A lock file pins the content hash whichever source supplies a package, and rule I1
  reads it.")
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="broiler-shared" value="eng/packages" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Broiler.ECMAScript.*" />
      <package pattern="Broiler.Unicode.*" />
    </packageSource>
    <packageSource key="broiler-shared">
      <package pattern="Broiler.ECMAScript.*" />
      <package pattern="Broiler.Unicode.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

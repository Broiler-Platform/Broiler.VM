<!-- Violates N4: a profile-family project declaring a PackageId. A family project packs under its
     assembly name, and a PackageId that is not the assembly's would publish the family under a name
     nothing else in the component uses. The project is otherwise packable, so the PackageId is the
     one violation. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Format</AssemblyName>
    <PackageId>Broiler.VM.JavaScript.Format</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
</Project>

<!-- Violates N4: a profile-family project whose only IsPackable true is metadata of an item. Item
     metadata is not a property, while a reader that counts every element of that name finds a
     definition. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Format</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <IsPackable>true</IsPackable>
    </None>
  </ItemGroup>
</Project>

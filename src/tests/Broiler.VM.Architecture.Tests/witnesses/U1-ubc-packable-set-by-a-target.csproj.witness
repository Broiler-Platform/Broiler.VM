<!-- Violates U1: the universal bytecode declaring IsPackable false and then setting it to true in a
     target that runs before the pack. A target's property group changes the property for every
     target that runs after it, the pack's included, so a reader that set targets aside as no
     definition would see only the false one. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Ubc</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Target Name="Packable" BeforeTargets="Pack">
    <PropertyGroup>
      <IsPackable>true</IsPackable>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
  </ItemGroup>
</Project>

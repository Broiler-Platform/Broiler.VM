<!-- Violates N4: a profile-family project whose only mention of IsPackable true is inside a
     comment. A comment is not a definition, while a search of the file's text finds the words. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Format</AssemblyName>
    <!-- Since 2026-09-19 this reads <IsPackable>true</IsPackable>. -->
  </PropertyGroup>
</Project>

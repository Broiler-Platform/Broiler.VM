// Witness for rule J2: a falsification criterion line that states no criterion.
//
// The line is present, so a reader at the declaration sees that a criterion was written and
// reads nothing. An empty instruction is worse than an absent one, because the clause that
// requires one on a High unit is satisfied by the line being there.

namespace Probe;

// Broiler-AI:           Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=TBF
// Broiler-Human:        PENDING
public static class Silent
{
    // Broiler-AI:           Origin=AI; IP=Low; Security=High; Resources=3; Fingerprint=TBF
    // Broiler-Falsified-If:
    // Broiler-Human:        PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

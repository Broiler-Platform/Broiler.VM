// Witness for rule J2: IP risk is one of five values. Minimal reads like one and is not one.


namespace Probe;

// Broiler-AI:           Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=48D70A
// Broiler-Human:        PENDING
public static class Assessed
{
    // Broiler-AI:           Origin=AI; IP=Minimal; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human:        PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

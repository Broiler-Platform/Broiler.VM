// Witness for rule J4: what a generation over a PENDING unit may change.
//
// Exactly one thing: the Fingerprint field. The human line comes out byte for byte
// as it went in.


namespace Probe;

public static class Assessed
{
    // Broiler-AI:    Origin=AI; IP=Low; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human: PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

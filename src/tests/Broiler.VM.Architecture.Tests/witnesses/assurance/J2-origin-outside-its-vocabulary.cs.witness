// Witness for rule J2: Origin is one of six values. Robot is not one of them.


namespace Probe;

public static class Assessed
{
    // Broiler-AI:    Origin=Robot; IP=Low; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human: PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

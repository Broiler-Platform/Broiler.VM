// Witness for rule J2: an escape hatch with nothing written in it.
//
// EXEMPT with no reason is an exemption nobody can review, which is the one thing
// the per-unit hatch may not become.


namespace Probe;

// Broiler-AI:           Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=48D70A
// Broiler-Human:        PENDING
public static class Assessed
{
    // Broiler-AI:           EXEMPT=
    // Broiler-Human:        PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

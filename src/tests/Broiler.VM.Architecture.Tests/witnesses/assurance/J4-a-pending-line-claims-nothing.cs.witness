// Witness for rule J4: the accepted direction, and the state of the whole component.
//
// PENDING is the only human line anything in Broiler.VM carries. A rule that
// rejected it would reject the honest record along with the false one.


namespace Probe;

public static class Assessed
{
    // Broiler-AI:    Origin=AI; IP=Low; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human: PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

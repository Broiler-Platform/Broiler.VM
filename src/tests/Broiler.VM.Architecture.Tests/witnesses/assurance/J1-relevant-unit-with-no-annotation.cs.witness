// Witness for rule J1: a relevant unit that carries no assurance annotation.
//
// Nothing exempts Fold. It has a statement body, a loop and a decision, so the
// exemption predicate answers None and the coverage clause must name it.

namespace Probe;

public static class Uncovered
{
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

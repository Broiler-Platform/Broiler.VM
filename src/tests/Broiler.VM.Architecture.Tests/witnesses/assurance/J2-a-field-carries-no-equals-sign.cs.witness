// Witness for rule J2: a field with no '=' in it, so the block does not parse.
//
// A line that does not parse is not an annotation. Both of its lines are reported
// as stranded - the second one because a human line on its own opens no block.


namespace Probe;

// Broiler-AI:           Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=48D70A
// Broiler-Human:        PENDING
public static class Assessed
{
    // Broiler-AI:           Origin=AI; IP Low; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human:        PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

// Witness for rule J1: eight units the exemption predicate covers, and no annotation.
//
// The coverage clause must report nothing here. A rule that named every unannotated
// unit regardless of the predicate would be a rule about comments rather than about
// review, and it would make several hundred trivial members unreviewable noise.
//
// Every property and accessor here returns or assigns the field CORRESPONDING to it,
// which is what case 1 asks for. A property that published some other field would be
// a decision about which value the type exposes, and is witnessed separately.
//
// The two fields are units as well - every field declaration is - and the predicate
// answers case 7 for them: they declare storage, and what the storage holds is decided
// by the constructor above, which is itself exempt for assigning its own parameter.
// Being a unit is not the same as being relevant; the manifest watches all eight.

namespace Probe;

// Broiler-AI:           Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=FF09AB
// Broiler-Human:        PENDING
public sealed class Trivial
{
    private readonly int stored;

    private readonly int copy;

    public Trivial(int stored)
    {
        this.stored = stored;
    }

    public int Stored => this.stored;

    public int Doubled { get; }

    public int Copy
    {
        get { return this.copy; }
    }

    public override string ToString() => Describe(this.stored);

    private static string Describe(int value) => "trivial";
}

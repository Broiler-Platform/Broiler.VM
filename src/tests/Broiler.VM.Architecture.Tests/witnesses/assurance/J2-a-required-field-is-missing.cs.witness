// Witness for rule J2: Security is required. An assessment that omits a dimension has not assessed it.


namespace Probe;

public static class Assessed
{
    // Broiler-AI:    Origin=AI; IP=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human: PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

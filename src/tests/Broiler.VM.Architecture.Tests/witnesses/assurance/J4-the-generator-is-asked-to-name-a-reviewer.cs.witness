// Witness for rule J4: the policy's hardest rule, as an input.
//
// The source says PENDING. The generator is handed a replacement body naming a
// reviewer - the transformation the policy forbids CI from performing - and must
// throw rather than write it. This is the one clause enforced by an exception
// rather than by a report, because a bug that reached for it must fail loudly.


namespace Probe;

// Broiler-AI:    Origin=AI; IP=Low; Security=Low; Resources=0; Fingerprint=48D70A
// Broiler-Human: PENDING
public static class Assessed
{
    // Broiler-AI:    Origin=AI; IP=Low; Security=Low; Resources=3; Fingerprint=TBF
    // Broiler-Human: PENDING
    public static int Fold(int[] values)
    {
        var total = 0;

        foreach (var value in values)
        {
            if (value > 0)
            {
                total += value;
            }
        }

        return total;
    }
}

<!-- Violates U1: the universal bytecode whose only IsPackable true is set inside a target. A
     target's property group sets the property only if the target runs, and only for the targets
     that run after it, so the evaluated property is whatever an import says, while a reader that
     counts every element of that name finds a definition. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Ubc</AssemblyName>
  </PropertyGroup>
  <Target Name="Packable" BeforeTargets="Build">
    <PropertyGroup>
      <IsPackable>true</IsPackable>
    </PropertyGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
  </ItemGroup>
</Project>

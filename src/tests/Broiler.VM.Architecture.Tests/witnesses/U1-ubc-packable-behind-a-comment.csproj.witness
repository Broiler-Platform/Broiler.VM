<!-- Violates U1: the universal bytecode whose only mention of IsPackable is inside a comment. A
     comment is not a definition, so the vendored packaging props' default of true stands and the
     project packs under its assembly name, while a search of the file's text finds the words. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Ubc</AssemblyName>
    <!-- Until UBC-9 this read <IsPackable>false</IsPackable>. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
  </ItemGroup>
</Project>

<!-- Violates U1: the universal bytecode carrying a package identity. The package is published under
     its assembly name, as decision UBC-D-5 took it, and a PackageId would be a second name for it -
     one that survives a rename of the assembly and parts the package from what it holds. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Ubc</AssemblyName>
    <PackageId>Broiler.VM.Ubc</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
  </ItemGroup>
</Project>

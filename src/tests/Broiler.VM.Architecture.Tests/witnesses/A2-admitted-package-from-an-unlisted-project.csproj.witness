<!-- Violates A2 as revised at SJL-2 (governance section 3.1's third witness): an ADMITTED package,
     Broiler.ECMAScript.Algorithms, referenced from a project the allow-list does not name for it.
     Admission is per project: the identifier being on the list is not enough. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Broiler.ECMAScript.Algorithms" Version="0.0.1-probe.1" />
  </ItemGroup>
</Project>

<!-- Violates U1: the universal bytecode declaring a PackageReference. A package can reintroduce an
     edge no project reference spells out, so the assembly every family references would carry a
     closure nobody reading its project file could see. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Ubc</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>
</Project>

<!-- Violates N4: a JavaScript-family project whose only IsPackable false is metadata of an item.
     Item metadata is not a property, so the vendored packaging props' default of true stands and
     the project packs, while a reader that counts every element of that name finds a definition. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Format</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md">
      <IsPackable>false</IsPackable>
    </None>
  </ItemGroup>
</Project>

<!-- Violates N4: a profile-family project whose only IsPackable true is set inside a target. A
     target's property group sets the property only if the target runs, and only for the targets
     that run after it, while a reader that counts every element of that name finds a definition. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Format</AssemblyName>
  </PropertyGroup>
  <Target Name="Packable" BeforeTargets="Build">
    <PropertyGroup>
      <IsPackable>true</IsPackable>
    </PropertyGroup>
  </Target>
</Project>

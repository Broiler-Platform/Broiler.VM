<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.VM.Architecture.Tests</RootNamespace>
    <AssemblyName>Broiler.VM.Architecture.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- The Broiler Code Assurance scanner parses the product sources with Roslyn, because the
         policy asks for a fingerprint over syntax rather than over file text.

         The centrally selected Microsoft.CodeAnalysis.CSharp release supplies the syntax API.
         Its version remains in Directory.Packages.props; no product project acquires it.

         THIS PROJECT ONLY. Rule A2 forbids a Broiler package outside rule I1's allow-list and this
         is not one; rule B1 constrains Abstractions and Binary and this project is neither;
         NuGet.config's source mapping sends every package outside the shared Broiler.ECMAScript
         prefix to nuget.org, where this package resolves. No product project may acquire it - a
         parser in a shipping assembly would be a dependency the component does not have, and rule
         I1 refuses a product package reference the allow-list does not name.
         (Revised 2026-10-12, at SJL-2.7: it said NuGet.config "clears every source and lists
         nuget.org", true until the committed feed was added for the shared packages.) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

    <!-- Reflection over an assembly this project may not reference and must not run.

         The public-API baseline describes a surface by reflecting over it. For the three packable
         assemblies that is ordinary Assembly.Load, because a ProjectReference puts them in this
         project's output. For the JavaScript profile's three it cannot be: rule A11 forbids a test
         project to reference a profile assembly, and that prohibition is one of the things this
         component exists to demonstrate rather than an inconvenience to work around.

         Assembly.LoadFrom over the built file is not the way out either. Loading RUNS module
         initializers - which invariant 2 forbids and rule B5b exists to detect - so a describer
         built on it would execute the code it is describing. MetadataLoadContext reflects without
         running anything, which is the same reason AssemblyFacts reads metadata tables directly
         for the group B rules.

         THIS PROJECT ONLY, like the Roslyn reference above, and for the same reason: a reflection
         host in a shipping assembly would be a dependency this component does not have. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" />

    <!-- THE UNICODE AREA'S OWNER GENERATOR (JSD-0074, decision SJL-D-6 (c); milestone SJL-7.4): rules
         N22 and N28 regenerate the embedded Unicode tables with it from this repository's pin, and rule
         I4 holds that pin equal to the owner's, which the package carries. It reaches this project "as a
         pinned, test-only package, and never a product closure": rule I1's allow-list admits it
         test-only for this project alone, NuGet restore metadata records its content hash and that of
         Broiler.Unicode.Algorithms, which it depends on, and CI verifies the resolved metadata. -->
    <PackageReference Include="Broiler.Unicode.Generation" />

    <!-- THE TIME DATA HOME'S GENERATOR (JSD-0076, decision SJL-D-6 (c); milestone SJL-8.5): rules N29 to N32
         regenerate the time zone and calendar tables with it from this repository's pins, and rule I4 holds
         the data versions it declares to those pins. It reaches this project as the Unicode area's
         generator does, "as a pinned, test-only package, and never a product closure": rule I1's
         allow-list admits it test-only for this project alone, and NuGet restore metadata records its
         content hash. -->
    <PackageReference Include="Broiler.ECMAScript.Generation" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Runtime\Broiler.VM.Runtime.csproj" />
    <ProjectReference Include="..\Broiler.VM.Fixtures\Broiler.VM.Fixtures.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

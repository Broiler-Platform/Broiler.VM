<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.VM.Fixtures</RootNamespace>
    <AssemblyName>Broiler.VM.Fixtures</AssemblyName>
    <Description>The fixture profile and application-local consumer profile that prove the Broiler.VM contracts. Test-only: never referenced by a product package. VM-0 project shell.</Description>

    <!-- Test-only. The packaging props default packability on by naming
         convention, and this project's name does not end in .Tests, so the
         value is set explicitly here. ADR 0001 makes the src/tests/ PATH -
         not the name - the authority for the product/test partition. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ADR 0001: a fixture profile is a profile. It gets exactly the edges a
       profile gets, which is how it proves the profile contract is reachable. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
  </ItemGroup>


</Project>

archive git archive --format=tar.gz b725bb06567f54a3273f4c92dd4c5fa09456f21d -- conformance/vectors :(exclude)conformance/vectors/controls
archive-sha256 7e618aef3f9c9850277445afeeaf955f97dd5178235aad195b155ef07ddcc224
content-sha256 738b4a0a82418072e559ea281b9f2c67bb17e907d46480a853210ead398c78de

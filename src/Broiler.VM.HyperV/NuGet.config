<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Restore sources for Broiler.VM.HyperV.

    <clear /> drops whatever sources the machine happens to have configured, so a restore
    resolves the same way on every developer box and in CI.

    The library itself has no package references at all - it binds WinHvPlatform.dll and
    WinHvEmulation.dll directly - so nuget.org is only reached for the test host.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.VM.Composition.WebAssembly.Execution</RootNamespace>
    <AssemblyName>Broiler.VM.Composition.WebAssembly.Execution</AssemblyName>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Not advertised. The composition register lists this root as a demonstration, packaging is
         WA-10's decision, and rule N4 holds the profile side of the same claim. -->
    <IsPackable>false</IsPackable>

    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    THE CLOSURE, STATED AS A REFERENCE SET.

    Six assemblies: the three the core is, the profile, and the universal bytecode with its bytecode
    emitter as the profile's siblings. The profile translates a WebAssembly module produced by an
    external toolchain into universal bytecode and declares the WebAssembly family; the core
    verifies the translation's artifact, and the family executes through the one form this root
    composes. A family names no emitter, so the root builds the family's descriptor over the bytecode
    emitter itself, and that is why this project names both.

    Until the universal bytecode programme's milestone UBC-4 this was the execution-only closure of
    four assemblies, and the label meant something narrower here than for a compiling profile: the
    image could not turn anything into an artifact because the profile carried no lowering at all.
    The translator is a lowering, it is in this image, and the image no longer claims the label.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Binary\Broiler.VM.Binary.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Runtime\Broiler.VM.Runtime.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Ubc\Broiler.VM.Ubc.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Emitter.Bytecode\Broiler.VM.Emitter.Bytecode.csproj" />
    <ProjectReference Include="..\..\Broiler.VM.Profile.WebAssembly\Broiler.VM.Profile.WebAssembly.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.VM.Profile.JavaScript.Compiler</RootNamespace>
    <AssemblyName>Broiler.VM.Profile.JavaScript.Compiler</AssemblyName>
    <Description>The JavaScript profile's lowering: tokenizer, syntax tree, static semantics and source-to-bytecode translation. A sibling of the profile, not a part of it. It lowers the slice and the wide manifests and emits the native forms; the status ledger is the authority for what exists.</Description>

    <!-- JS-0 declares no package; see the Format project for why. -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    The lowering references the format because it writes it, and Abstractions because a lowering
    stamps a feature-manifest identity into what it emits. It never references the profile: the
    dependency runs profile -> format <- lowering, which is what lets a composition carry the
    profile without carrying a compiler.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Broiler.VM.Abstractions\Broiler.VM.Abstractions.csproj" />
    <ProjectReference Include="..\Broiler.VM.Profile.JavaScript.Format\Broiler.VM.Profile.JavaScript.Format.csproj" />
  </ItemGroup>

  <!--
    THE SHARED ALGORITHMS LIBRARY (ADR 0014; JSD-0065, milestone SJL-3.4): the compiler's numeric literal values, BigInt literals under the format's ceiling included, and numeric property keys. The
    package comes from the committed feed eng/packages/ at its pin, the lock file records its
    content hash, and rule I1 holds both to the allow-list, which names this project.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A restore for one runtime identifier - a trimmed or Native AOT publish - adds that RID's
         own packages (the IL compiler, the linker tasks) to the graph. It writes its lock file under
         obj/, so the committed lock file stays the RID-less one CI restores in locked mode and rule
         I1 reads, and a publish leaves the tree as it found it. -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.ECMAScript.Algorithms" />
  </ItemGroup>

</Project>

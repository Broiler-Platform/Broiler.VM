<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Broiler.VM.Binary</RootNamespace>
    <AssemblyName>Broiler.VM.Binary</AssemblyName>
    <PackageId>Broiler.VM.Binary</PackageId>
    <Description>Bounded binary-reading and bounded-allocation primitives shared by the Broiler.VM core envelope and by every profile verifier: checked readers, canonical-only LEB128, section framing, guarded declared counts and allocation guards. No format, no schema, no semantics.</Description>
  </PropertyGroup>

  <!-- ADR 0001: this project has no ProjectReference. It is a sink of the
       dependency graph. It deliberately does not reference Abstractions:
       bounded reading is mechanism and must not acquire contract vocabulary. -->


</Project>
